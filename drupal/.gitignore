# Composer-managed code
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/recipes/
# Drupal scaffold files (regenerated by Composer)
/web/*.php
/web/*.txt
/web/.htaccess
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.ht.router.php
/web/example.gitignore
/web/INSTALL.txt
/web/README.md
/web/update.php
/web/robots.txt
/web/web.config
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/example.*
/web/sites/default/default.*
# Site-specific and generated
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml
/import/__test*.json
