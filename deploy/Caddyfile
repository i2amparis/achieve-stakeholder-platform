# HTTPS certificates are obtained automatically (Let's Encrypt) once DNS points here.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		# demo: keep it out of search engines until the public launch
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

# The public site. While it is a demo, it sits behind a shared password: the
# content is not yet confirmed by partners and the privacy notice is not published.
{$SITE_DOMAIN} {
	import common
	basic_auth {
		{$DEMO_USER} {$DEMO_PASSWORD_HASH}
	}
	reverse_proxy web:3000
}

# Directus (admin app and API). It has its own login.
{$CMS_DOMAIN} {
	import common
	reverse_proxy directus:8055
}
