# Copy to .env (git-ignored) for local development.

# SvelteKit site → Drupal (local DDEV site)
DRUPAL_URL=http://achieve-cms.ddev.site:8580
# Same value as $settings['achieve_feedback_secret'] in drupal/web/sites/default/settings.local.php
#   php -r 'echo bin2hex(random_bytes(32));'   (or: openssl rand -hex 32)
DRUPAL_FEEDBACK_SECRET=

# Optional, for a demo: a shared password for the whole site, and noindex
# DEMO_USER=achieve
# DEMO_PASSWORD=
